# .env.example — copy to .env and fill in values.
# Real values live in the shared OpenClaw workspace secrets.md at:
#   C:\Users\Admin\.openclaw\workspace\secrets.md
# (see README for why this project reads from there)
#
# Only needed if you want to override at runtime via environment variables.
# Leave empty for normal local development — the loader falls back to secrets.md.

# OpenAI-compatible LLM endpoint (Ollama cloud or any compatible provider)
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=minimax-m3:cloud
LLM_API_KEY=

# Server
PORT=3000
